{
  "name": "@uselab/linting",
  "version": "1.0.4",
  "description": "Uselab linting rules",
  "type": "module",
  "license": "MIT",
  "author": "Constantijn for Uselab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uselab/linting.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "uselab-linting": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./prettier": {
      "types": "./dist/prettier.d.ts",
      "import": "./dist/prettier.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "quality": "npm run build && npm run typecheck && npm run lint && npm test",
    "prepublishOnly": "npm run build",
    "prepare": "simple-git-hooks",
    "preversion": "npm run quality",
    "postversion": "git push --follow-tags",
    "lint:analyze": "uselab-linting analyze"
  },
  "simple-git-hooks": {
    "pre-push": "npm run quality"
  },
  "keywords": [
    "uselab",
    "linting",
    "formatting",
    "prettier",
    "typescript",
    "javascript",
    "vue",
    "react"
  ],
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "jiti": "^2.7.0",
    "prettier": "^3.10.0",
    "simple-git-hooks": "^2.13.1",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@clack/core": "^1.6.0",
    "@clack/prompts": "^1.9.0",
    "@eslint-react/eslint-plugin": "^5.30.1",
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.2",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "eslint-plugin-vue": "^10.12.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "globals": "^17.14.0",
    "jsonc-parser": "^3.3.1",
    "magicast": "^0.5.5",
    "prettier-plugin-curly": "^0.4.2",
    "typescript-eslint": "^8.72.2",
    "vue-eslint-parser": "^10.4.2"
  },
  "peerDependencies": {
    "eslint": "^10.4.0",
    "prettier": "^3.5.0",
    "typescript": ">=5.0.0 <6.1.0"
  },
  "peerDependenciesMeta": {
    "prettier": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  }
}
